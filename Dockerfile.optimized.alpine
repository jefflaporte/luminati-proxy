# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom

# Alpine/musl packaging of the same published npm release. See docker/README.optimized.md.
# Version arguments come from the build script; the browser remains optional.
ARG NODE_VERSION
ARG WITH_CHROME=true

FROM node:${NODE_VERSION}-alpine AS dependencies
ARG TARGETARCH
ARG LPM_VERSION

# Chrome's downloads target glibc. Alpine uses its native Chromium package on
# both architectures; compile native addons against musl in this builder.
ENV PUPPETEER_CACHE_DIR=/opt/puppeteer \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_CHROME_HEADLESS_SHELL_SKIP_DOWNLOAD=true \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/prisma_brightdata_ca.pem \
    OPENSSL_CONF=/etc/ssl/openssl.cnf

COPY docker/prisma_brightdata_ca.crt /usr/local/share/ca-certificates/

RUN set -eu; \
    : "${LPM_VERSION:?LPM_VERSION is required; use scripts/build-image-optimized.sh}"; \
    case "$TARGETARCH" in \
        amd64|arm64) ;; \
        *) printf 'Unsupported architecture: %s\n' "$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    apk add --no-cache ca-certificates openssl python3 make g++; \
    update-ca-certificates; \
    ln -sf /usr/local/share/ca-certificates/prisma_brightdata_ca.crt \
        /etc/ssl/certs/prisma_brightdata_ca.pem; \
    { printf '%s\n' 'nodejs_conf = openssl_init'; \
        cat /etc/ssl/openssl.cnf; \
        printf '\n%s\n' '[openssl_init]' 'ssl_conf = ssl_sect' \
            '[ssl_sect]' 'system_default = system_default_sect' \
            '[system_default_sect]' 'Options = UnsafeLegacyRenegotiation'; \
    } > /tmp/openssl.cnf; \
    mv /tmp/openssl.cnf /etc/ssl/openssl.cnf; \
    npm install --global npm@10.9.2; \
    npm install --global --omit=dev --legacy-peer-deps \
        "@luminati-io/luminati-proxy@${LPM_VERSION}"; \
    mkdir -p /opt/puppeteer; \
    test -s /usr/local/lib/node_modules/@luminati-io/luminati-proxy/bin/pub/index.html; \
    node -e 'require("/usr/local/lib/node_modules/@luminati-io/luminati-proxy/node_modules/puppeteer")'

FROM node:${NODE_VERSION}-alpine AS runtime

COPY docker/prisma_brightdata_ca.crt /usr/local/share/ca-certificates/

# Keep Bash for certificate generation, GNU utilities/process tools for the
# application's shell commands, and the existing CA/OpenSSL behavior.
RUN apk add --no-cache \
        bash ca-certificates coreutils curl libstdc++ lsb-release-minimal openssl procps-ng \
    && update-ca-certificates \
    && ln -sf /usr/local/share/ca-certificates/prisma_brightdata_ca.crt \
        /etc/ssl/certs/prisma_brightdata_ca.pem

COPY --from=dependencies /etc/ssl/openssl.cnf /etc/ssl/openssl.cnf
COPY --from=dependencies /usr/local/lib/node_modules/@luminati-io/luminati-proxy /usr/local/lib/node_modules/@luminati-io/luminati-proxy
COPY --from=dependencies /opt/puppeteer /opt/puppeteer

ENV DOCKER=1 \
    PUPPETEER_CACHE_DIR=/opt/puppeteer \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_CHROME_HEADLESS_SHELL_SKIP_DOWNLOAD=true \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/prisma_brightdata_ca.pem \
    OPENSSL_CONF=/etc/ssl/openssl.cnf

RUN set -eu; \
    for command in luminati luminati-proxy pmgr proxy-manager; do \
        ln -s ../lib/node_modules/@luminati-io/luminati-proxy/bin/index.js \
            "/usr/local/bin/$command"; \
    done

# Load addons under Node to check both native library dependencies and the ABI.
# Use a fresh process for each path: node-gyp can leave hard-linked copies of
# legacy addons that cannot register twice in the same process.
# This runs before browser packages are installed, covering browser-free builds.
RUN node -e 'const fs = require("node:fs"), path = require("node:path"); \
    const {execFileSync} = require("node:child_process"); \
    function check(dir) { \
        for (const entry of fs.readdirSync(dir, {withFileTypes: true})) { \
            const name = path.join(dir, entry.name); \
            if (entry.isDirectory()) check(name); \
            else if (entry.isFile() && name.endsWith(".node")) \
                execFileSync(process.execPath, ["-e", "require(process.argv[1])", name], \
                    {stdio: "inherit"}); \
        } \
    } \
    check("/usr/local/lib/node_modules/@luminati-io/luminati-proxy/node_modules")'

FROM runtime AS browser-true
RUN apk add --no-cache chromium font-liberation
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

FROM runtime AS browser-false

# The browser and its GUI libraries do not enter browser-free image layers.
FROM browser-${WITH_CHROME} AS optimized
ARG WITH_CHROME

RUN set -eu; \
    if [ "$WITH_CHROME" = true ]; then \
        node -e 'const fs = require("node:fs"); \
            const p = require("/usr/local/lib/node_modules/@luminati-io/luminati-proxy/node_modules/puppeteer"); \
            fs.accessSync(p.executablePath(), fs.constants.X_OK)'; \
        if ! ldd /usr/lib/chromium/chrome > /tmp/browser-libraries 2>&1; then \
            cat /tmp/browser-libraries; exit 1; \
        fi; \
        if grep -Eq 'not found|Error loading|Error relocating' /tmp/browser-libraries; then \
            cat /tmp/browser-libraries; exit 1; \
        fi; \
        rm /tmp/browser-libraries; \
    else \
        test -z "$(find /opt/puppeteer -type f -print -quit)"; \
        test ! -e /usr/bin/chromium-browser; \
    fi

CMD ["luminati", "--help"]
